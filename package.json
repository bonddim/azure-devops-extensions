{
  "name": "azure-devops-extensions",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.2",
      "onFail": "warn"
    }
  },
  "scripts": {
    "prepare": "git fetch origin main",
    "changeset": "changeset",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "test": "vitest",
    "prebuild": "pnpm --filter ./packages/* --if-present run build",
    "build": "pnpm  --filter ...[${PNPM_BASE:-origin/main}] --if-present run build",
    "package": "pnpm --filter ...[${PNPM_BASE:-origin/main}] --if-present run package",
    "publish": "pnpm --filter ...[${PNPM_BASE:-origin/main}] --if-present run publish",
    "release": "pnpm run publish && changeset git-tag"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "glob": "14.0.3",
    "simple-git-hooks": "2.14.0",
    "tfx-cli": "0.24.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vitest-sonar-reporter": "3.0.0"
  }
}
