{
  "name": "azure-devops-extensions",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.13.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "prepare": "git fetch origin main",
    "changeset": "changeset",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "test": "vitest",
    "prebuild": "pnpm --filter ./packages/* --if-present run build",
    "build": "pnpm  --filter ...[${PNPM_BASE:-origin/main}] --if-present run build",
    "package": "pnpm --filter ...[${PNPM_BASE:-origin/main}] --if-present run package",
    "publish": "pnpm --filter ...[${PNPM_BASE:-origin/main}] --if-present run publish",
    "release": "pnpm run publish && changeset git-tag"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --fix"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "azure-pipelines-task-lib": "^5.279.0",
    "azure-pipelines-tool-lib": "^2.280.0",
    "semver": "^7.8.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "glob": "13.0.6",
    "simple-git-hooks": "2.14.0",
    "tfx-cli": "0.24.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vitest-sonar-reporter": "3.0.0"
  }
}
