{
  "name": "argo-cd-cli-extension",
  "version": "1.0.5",
  "private": true,
  "scripts": {
    "build": "node ../../tools/build-tasks.mjs",
    "package": "exec tfx extension create --manifest-js vss-extension.js",
    "publish": "exec tfx extension publish --manifest-js vss-extension.js --auth-type pat --token $ENTRA_TOKEN"
  },
  "dependencies": {
    "@bonddim/utils": "workspace:*",
    "azure-pipelines-task-lib": "catalog:",
    "azure-pipelines-tool-lib": "catalog:",
    "tslib": "catalog:"
  }
}
